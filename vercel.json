{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" },
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/chat", "dest": "/api/chat.js" },
    { "src": "/api/transcript", "dest": "/api/transcript.js" },
    { "src": "/", "dest": "/index.html" }
  ]
}
